# Admin password (plain text). Change it before putting the site on a VPS.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Use a long random string in production.
SESSION_SECRET=dev-only-secret-change-me-please-32-chars-min

# Public base URL of the site. QR codes encode BASE_URL + /o/<CODE>.
# Local:      http://localhost:3000
# Production: https://passport.your-domain.com
BASE_URL=http://localhost:3000

# Where the SQLite database and uploaded photos live (relative to project root).
DATA_DIR=./data

# Optional brand defaults (also editable in the admin UI -> Settings)
BRAND_NAME=OBJET
