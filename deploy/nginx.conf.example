# /etc/nginx/sites-available/objet
# Проксирует домен на локальный Next.js и отдаёт статику напрямую.
server {
  listen 80;
  server_name passport.example.com;

  client_max_body_size 25m;   # загрузка фотографий

  location /_next/static/ {
    alias /var/www/objet/.next/static/;
    expires 365d;
    access_log off;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# После certbot (HTTPS) не забудьте поменять BASE_URL и адрес в Настройках на https://...
