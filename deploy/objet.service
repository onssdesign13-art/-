# /etc/systemd/system/objet.service
# Продакшен-запуск на VPS: systemctl daemon-reload && systemctl enable --now objet
[Unit]
Description=Objet passport pages
After=network.target

[Service]
Type=simple
User=objet
WorkingDirectory=/var/www/objet
Environment=NODE_ENV=production
EnvironmentFile=/var/www/objet/.env.local
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
